{
  "name": "@workspace/involv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:applications": "node tests/security/run-school-access.mjs --applications && node tests/security/application-client.mjs",
    "test:corrections": "node tests/security/run-school-access.mjs --corrections",
    "test:messaging-controls": "node tests/security/run-school-access.mjs --messaging-controls",
    "test:messaging-client": "node tests/security/messaging-client.mjs",
    "test:pilot-privacy": "node tests/security/run-school-access.mjs --pilot-privacy",
    "test:pilot-client": "node tests/security/pilot-client.mjs",
    "test:opportunity-taxonomy": "node tests/security/opportunity-taxonomy.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:security": "node tests/security/run-launch-security-checks.mjs",
    "test:console-privacy": "pnpm run build && node tests/security/console-privacy.mjs",
    "test:school-access": "node tests/security/run-school-access.mjs",
    "test:activity": "node tests/security/run-school-access.mjs --activity",
    "test:messaging": "node tests/security/run-school-access.mjs --messaging",
    "test:reflections": "node tests/security/run-school-access.mjs --reflections && node tests/security/reflection-client.mjs",
    "test:participation": "node tests/security/run-school-access.mjs --participation",
    "test:portfolio": "node tests/security/run-school-access.mjs --portfolio && node tests/security/portfolio-csv.mjs",
    "load:50": "VUS=50 node tests/load/launch-readiness.mjs",
    "load:100": "VUS=100 node tests/load/launch-readiness.mjs",
    "test:full-stack": "node tests/security/run-full-stack.mjs",
    "test:lti": "node tests/lti/lti-flow.mjs",
    "typecheck:api": "tsc -p api/tsconfig.json"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.106.2",
    "jose": "6.2.10",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "esbuild": "0.27.3",
    "postcss": "^8.4.31",
    "supabase": "^2.101.0",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  }
}
