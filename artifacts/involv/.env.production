# ── Involv site mode ─────────────────────────────────────────────────────────
# true  = DEMO: sample data in the visitor's browser, no sign-in, nothing saved.
# false = REAL: ISZL Google sign-in and the Supabase database.
#
# To switch to the real site when the school approves: change true to false,
# commit, and push (Vercel redeploys automatically). A VITE_DEMO_MODE variable
# set in Vercel → Settings → Environment Variables overrides this file.
# See docs/DEMO_MODE.md.
VITE_DEMO_MODE=true
